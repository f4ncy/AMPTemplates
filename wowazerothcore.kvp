App.AdminMethod=STDIO
App.ApplicationPort1=8085
App.ApplicationPort2=3724
App.ApplicationReadyMode=Immediate
App.BaseDirectory=./wow-azerothcore-dads-mmo-lab/
App.CommandLineArgs=compose up
App.CommandLineParameterDelimiter= 
App.CommandLineParameterFormat=-{0} "{1}"
App.DisplayName=WoW AzerothCore (Dads MMO Lab)
App.ExecutableLinux=docker
App.ExecutableWin=
App.ExitMethod=SIGINT
App.ExitString=stop
App.HasReadableConsole=true
App.HasWritableConsole=true
App.RapidStartup=false
App.RootDir=./wow-azerothcore-dads-mmo-lab/
App.UpdateSource=None
App.WorkingDir=
Console.AppReadyRegex=^.*World initialized.*$
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.UserChatRegex=^(?<username>.+?): (?<message>.+)$
Console.UserJoinRegex=^User (?<username>.+?) \((?<userid>-?d+)\) connected from \[::ffff:(?<endpoint>.+?)\]$
Console.UserLeaveRegex=^User (?<username>.+?) \((?<userid>-?d+)\) disconnected\. Reason: (.+?)$
Meta.Author=
Meta.ConfigManifest=wow-azerothcore-dads-mmo-labconfig.json
Meta.ConfigRoot=wow-azerothcore-dads-mmo-lab.kvp
Meta.Description=Offline WotLK (3.3.5a) with Playerbots and Unbound
Meta.DisplayImageSource=url:
Meta.DisplayName=WoW AzerothCore (Dads MMO Lab)
Meta.EndpointURIFormat=
Meta.OS=2
